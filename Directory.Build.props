<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PathMap>$(MSBuildThisFileDirectory)=/_/HollowSols/</PathMap>
    <HollowSolsPublicRelease Condition="'$(HollowSolsPublicRelease)' == ''">false</HollowSolsPublicRelease>
    <DefineConstants Condition="'$(HollowSolsPublicRelease)' == 'true'">$(DefineConstants);HOLLOWSOLS_PUBLIC_RELEASE</DefineConstants>
    <BepCore>$(MSBuildThisFileDirectory).local/deps/BepInEx-5.4.23.5/BepInEx/core</BepCore>
    <HollowKnightManaged>C:/Steam/steamapps/common/Hollow Knight/hollow_knight_Data/Managed</HollowKnightManaged>
    <NineSolsManaged>C:/Steam/steamapps/common/Nine Sols/NineSols_Data/Managed</NineSolsManaged>
  </PropertyGroup>
</Project>
